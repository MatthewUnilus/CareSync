# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
# pytest's tmpdir base (created when the suite runs without a system temp dir)
pytest-of-*/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# Node
node_modules/
dist/
build/
.vite/
coverage/

# Native shells: the Capacitor projects are committed so the app can be built
# from a clone. android/.gitignore and ios/.gitignore keep build products,
# copied web assets, local SDK paths, Pods and derived data out of git.
*.keystore

# Local data and models
*.db
*.sqlite3
data/
models/artifacts/
.env
.env.*

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Agent worktrees (resolve outside the repo lack a writable ACE)
.worktrees/

# Desktop agent scratch (machine-local)
AGENTS-DESKTOP-*.md
.zcode/
